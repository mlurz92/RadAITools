<Window x:Class="BefundExplorer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BefundExplorer.App.Controls" Title="Radiologie · BefundExplorer" Height="920" Width="1540" MinHeight="720" MinWidth="1180" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="BEFUNDEXPLORER" FontSize="18" FontWeight="Bold"/><TextBlock Text="CT · MR  |  Radiologischer Befundkorpus" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel><Grid Grid.Column="1" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" FontSize="15" VerticalContentAlignment="Center" ToolTip="Suchbegriff oder Phrase. Enter startet die Suche." KeyDown="SearchBox_KeyDown"/><ComboBox x:Name="ModeBox" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Intelligent" Tag="Intelligent"/><ComboBoxItem Content="Alle Wörter" Tag="AllWords"/><ComboBoxItem Content="Mind. ein Wort" Tag="AnyWord"/><ComboBoxItem Content="Exakte Phrase" Tag="ExactPhrase"/><ComboBoxItem Content="Wortanfang" Tag="Prefix"/><ComboBoxItem Content="Teilzeichenfolge" Tag="Substring"/><ComboBoxItem Content="Tolerant (ä/ae …)" Tag="Tolerant"/><ComboBoxItem Content="Expertenabfrage" Tag="Expert"/></ComboBox><Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Suchen" Click="Search_Click"/></Grid><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="ThemeButton" Content="Dunkel" Click="Theme_Click" ToolTip="Hell-/Dunkelmodus"/><Button Content="Export" Margin="8,0,0,0" Click="Export_Click" ToolTip="Alle aktuell gefilterten Treffer als CSV exportieren"/></StackPanel></Grid></Border>
<Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="500" MinWidth="390"/><ColumnDefinition Width="*" MinWidth="390"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="FILTER" FontWeight="Bold" FontSize="14"/><TextBlock Text="Modalität" Style="{StaticResource SectionLabel}"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="CtCheck" Content="CT" IsChecked="True" Margin="0,0,20,0"/><CheckBox x:Name="MrCheck" Content="MR" IsChecked="True"/></StackPanel><TextBlock Text="Suchfeld" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="FieldBox" SelectedIndex="0"><ComboBoxItem Content="Alle Berichtsfelder" Tag="All"/><ComboBoxItem Content="Studienbeschreibung" Tag="StudyDescription"/><ComboBoxItem Content="Titel" Tag="Title"/><ComboBoxItem Content="Klinische Angaben" Tag="ClinicalInformation"/><ComboBoxItem Content="Fragestellung" Tag="Question"/><ComboBoxItem Content="Methodik" Tag="Technique"/><ComboBoxItem Content="Befund" Tag="Findings"/><ComboBoxItem Content="Beurteilung" Tag="Impression"/></ComboBox><TextBlock Text="Studienbeschreibung" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="StudyBox" IsEditable="True" IsTextSearchEnabled="True"/><TextBlock Text="Strukturstatus" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="StatusBox"/><TextBlock Text="Beurteilung" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="ImpressionBox" SelectedIndex="0"><ComboBoxItem Content="Alle" Tag="all"/><ComboBoxItem Content="Vorhanden" Tag="yes"/><ComboBoxItem Content="Nicht vorhanden" Tag="no"/></ComboBox><TextBlock Text="Sortierung" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="SortBox" SelectedIndex="0"><ComboBoxItem Content="Relevanz" Tag="Relevance"/><ComboBoxItem Content="Originalreihenfolge ↑" Tag="OriginalAscending"/><ComboBoxItem Content="Originalreihenfolge ↓" Tag="OriginalDescending"/><ComboBoxItem Content="Studie A–Z" Tag="StudyAscending"/></ComboBox><TextBlock Text="Treffer pro Seite" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="PageSizeBox" SelectedIndex="1"><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="200"/></ComboBox><Button Content="Filter zurücksetzen" Margin="0,18,0,0" Click="Reset_Click"/><Separator Margin="0,16"/><TextBlock x:Name="DbInfo" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></ScrollViewer></Border>
<Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="13,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="TREFFER" FontWeight="Bold"/><TextBlock x:Name="ResultCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel></Border><ListBox x:Name="ResultsList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="ResultsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Padding="13,11" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel><DockPanel><Border Background="{DynamicResource AccentSoftBrush}" Padding="6,2" CornerRadius="4"><TextBlock Text="{Binding Modality}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11"/></Border><TextBlock DockPanel.Dock="Right" Text="{Binding Id, StringFormat=# {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></DockPanel><TextBlock Text="{Binding StudyDescription}" FontWeight="SemiBold" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Question}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="11"/><controls:MarkedTextBlock MarkedText="{Binding Snippet}" TextWrapping="Wra