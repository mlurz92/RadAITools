<Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Padding="13,9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Beurteilung kopieren" Margin="0,0,8,0" Click="CopyImpression_Click"/><Button Content="Befund kopieren" Click="CopyReport_Click"/></StackPanel><StackPanel><TextBlock x:Name="DetailHeader" Text="BEFUND" FontWeight="Bold"/><TextBlock x:Name="DetailMeta" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></DockPanel></Border><TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"><TabItem Header="Strukturiert"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"><StackPanel><TextBlock Text="KLINISCHE ANGABEN" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="ClinicalText" TextWrapping="Wrap"/><TextBlock Text="FRAGESTELLUNG" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="QuestionText" TextWrapping="Wrap"/><TextBlock Text="METHODIK" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="TechniqueText" TextWrapping="Wrap"/><TextBlock Text="BEFUND" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="FindingsText" TextWrapping="Wrap" LineHeight="21"/><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,20"><StackPanel><TextBlock Text="BEURTEILUNG" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="ImpressionText" TextWrapping="Wrap" Margin="0,7,0,0" FontWeight="SemiBold" LineHeight="21"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="Originaltext"><TextBox x:Name="OriginalText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="16" FontFamily="Consolas" FontSize="12"/></TabItem></TabControl></Grid></Border></Grid>
<Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PrevButton" Content="← Zurück" Click="Prev_Click"/><TextBlock x:Name="PageText" Margin="14,0" VerticalAlignment="Center"/><Button x:Name="NextButton" Content="Weiter →" Click="Next_Click"/></StackPanel><TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Strg+F = Suche · Enter = Start" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Grid></Border></Grid></Window>
